{
	"schemaVersion": 1,
	"id": "fastershadowmapper",
	"version": "${version}",
	"name": "Faster Shadow Mapper",
	"description": "Slightly improves the speed of the shadow mapper in popular shader mods including Iris, Optifine, Oculus and Beryl.",
	"authors": [
		"maDU59_"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/fastershadowmapper/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.madu59.fism.FasterIrisShadowMapper"
		],
		"client": [
			"fr.madu59.fism.client.FasterIrisShadowMapperClient"
		]
	},
	"mixins": [
		{
			"config": "fastershadowmapper.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}